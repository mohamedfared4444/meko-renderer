    {
      "id": "seg1",
      "scene": "scene1",
      "text": "النهارده هنشوف الشوكولاتة بتتعمل إزاي من الصفر.",
      "caption_groups": null
    },
    {
      "id": "seg2",
      "scene": "scene1",
      "text": "حبوب الكاكاو بتيجي من قرون شجرة الكاكاو، وبتوصلنا على سير النقل علطول.",
      "caption_groups": null
    },
    {
      "id": "seg3",
      "scene": "scene2",
      "text": "قبل التحميص الحبات بتتنضف كويس، وبعدين بتدخل طبلية التحميص الساخنة اللي بتطلع منها النكهة الغنية.",
      "caption_groups": null
    },
    {
      "id": "seg4",
      "scene": "scene3",
      "text": "وبعدين بتتطحن بين أسطانة حديد دوارة، بتتدوس الحبات لحد ما تبقى عجينة كاكاو سايحة.",
      "caption_groups": null
    },
    {
      "id": "seg5",
      "scene": "scene4",
      "text": "وبعدين تيجي المعالجة والخلط، تقليب على مهل بيحول العجينة لشوكولاتة سايحة ناعمة.",
      "caption_groups": null
    },
    {
      "id": "seg6",
      "scene": "scene5",
      "text": "الشوكولاتة السايحة بتتصب في القوالب، وبتعدى تونيل تبريد لحد ما تتماسك.",
      "caption_groups": null
    },
    {
      "id": "seg7",
      "scene": "scene6",
      "text": "وبكده الألواح بتطلع جاهزة، من حبة كاكاو لقطعة شوكولاتة.",
